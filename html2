      font-size: 13px;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .product-rating span {
      color: #94a3b8;
      font-size: 12px;
    }

    .price-box {
      margin-top: auto;
      margin-bottom: 14px;
    }
    .price-current {
      font-size: 18px;
      font-weight: 800;
      color: #dc2626;
    }
    .price-old {
