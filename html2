    .hero-banner h1 {
      font-size: 54px;
      font-weight: 900;
      letter-spacing: 1.5px;
      margin-bottom: 16px;
      text-transform: uppercase;
      text-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);
    }

    .hero-banner p {
      font-size: 20px;
      max-width: 780px;
      margin: 0 auto 34px;
      font-weight: 400;
      color: #f1f5f9;
      line-height: 1.5;
    }

    .btn-buy-now {
