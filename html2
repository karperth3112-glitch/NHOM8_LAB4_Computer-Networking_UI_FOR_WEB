      color: #ffffff;
      border-color: #4f46e5;
    }

    /* Grid Sản Phẩm Bán Hàng */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
      margin-bottom: 60px;
    }

    .product-card {
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      padding: 16px;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
      border-color: #c7d2fe;
    }

    .badge-discount {
