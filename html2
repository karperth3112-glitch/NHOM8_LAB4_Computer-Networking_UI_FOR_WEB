      color: #7e22ce;
      border: 1px solid #d8b4fe;
      padding: 10px 24px;
      border-radius: 999px;
      font-size: 15px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }
    .cart-btn:hover {
